<Application x:Class="DesktopFences.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <sys:Double x:Key="IconSize">48</sys:Double>
        <sys:Double x:Key="TileWidth">84</sys:Double>
        <Visibility x:Key="LabelVisibility">Visible</Visibility>
        <!-- Per-fence overrides are set in FenceWindow.ApplyAppearance (white or dark text). -->
        <SolidColorBrush x:Key="FenceTextBrush" Color="White" />
        <DropShadowEffect x:Key="FenceTextEffect" ShadowDepth="1" BlurRadius="3" Opacity="0.85" Color="Black" />

        <!-- Thin, unobtrusive scrollbar for fences -->
        <Style x:Key="FenceThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="3" Background="#55FFFFFF" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FenceScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="0,2,2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource FenceThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FenceItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4,6,4,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FenceItemTemplate">
            <StackPanel Width="{DynamicResource TileWidth}" Opacity="{Binding ItemOpacity}"
                        ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="900">
                <Image Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{Binding Icon}" />
                            <Style.Triggers>
                                <!-- "Blend with wallpaper": grey, see-through icons until the fence is pointed at -->
                                <DataTrigger Binding="{Binding Blended, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Source" Value="{Binding MutedIcon}" />
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock Text="{Binding Name}" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="32" FontSize="12"
                           Foreground="{DynamicResource FenceTextBrush}" Effect="{DynamicResource FenceTextEffect}"
                           Visibility="{DynamicResource LabelVisibility}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Blended, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Plain dialogs -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Application.Resources>
</Application>
