<Window x:Class="DesktopFences.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fence"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResize"
        MinWidth="140" MinHeight="32" AllowDrop="True"
        UseLayoutRounding="True" FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" CornerRadius="8" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#8C1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Background="#22000000" CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    LostMouseCapture="TitleBar_LostMouseCapture">
                <Grid>
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="12,0">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.7" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBox x:Name="TitleEdit" Visibility="Collapsed" Margin="8,4" Padding="2,0"
                             Background="#55000000" Foreground="White" CaretBrush="White" BorderThickness="0"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="13"
                             KeyDown="TitleEdit_KeyDown" LostKeyboardFocus="TitleEdit_LostKeyboardFocus" />
                </Grid>
            </Border>

            <ListBox x:Name="ItemsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="4,2,4,4"
                     SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     ItemContainerStyle="{StaticResource FenceItemStyle}"
                     ItemTemplate="{StaticResource FenceItemTemplate}"
                     PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="Items_PreviewMouseLeftButtonUp"
                     PreviewMouseMove="Items_PreviewMouseMove"
                     PreviewMouseRightButtonDown="Items_PreviewMouseRightButtonDown"
                     PreviewMouseRightButtonUp="Items_PreviewMouseRightButtonUp"
                     PreviewKeyDown="Items_PreviewKeyDown"
                     QueryContinueDrag="Items_QueryContinueDrag">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource FenceScrollBar}" />
                </ListBox.Resources>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="Drag icons here" Foreground="#AAFFFFFF" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="12">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.6" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</Window>
