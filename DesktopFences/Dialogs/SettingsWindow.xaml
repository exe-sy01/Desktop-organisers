<Window x:Class="DesktopFences.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Fences – Settings" Width="720" Height="660" MinWidth="600" MinHeight="480" Topmost="True"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="#F4F5F7" />
            <Setter Property="BorderBrush" Value="#E1E3E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageIntro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="Margin" Value="0,2,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,18,4" />
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click" />
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center">
                    <Run Text="Stored in" /> <Run x:Name="ConfigPath" />
                </TextBlock>
            </DockPanel>
        </Border>

        <TabControl TabStripPlacement="Left" BorderThickness="1,0,0,0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,9" />
                    <Setter Property="MinWidth" Value="140" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </TabControl.Resources>

            <!-- ============================================================ General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="How fences behave on your desktop." Style="{StaticResource PageIntro}" />

                        <TextBlock Text="Desktop icons" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="HideIcons" Content="Hide fenced icons from the bare desktop" />
                                <TextBlock x:Name="HiddenFilesWarning" Style="{StaticResource Hint}" Margin="22,0,0,4" Foreground="#B05A00"
                                           Visibility="Collapsed"
                                           Text="Explorer is set to show protected operating system files, so fenced icons will still appear (faded) on the desktop. Re-tick 'Hide protected operating system files' in Explorer's Folder Options to hide them fully." />
                                <CheckBox x:Name="HidePublic" Margin="22,2,0,4"
                                          Content="Also hide shortcuts on the shared Public Desktop (asks for admin permission)" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Mouse and keyboard" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="DoubleClick" Content="Double-click empty desktop space to hide / show fences" />
                                <CheckBox x:Name="SingleClick" Content="Open items with a single click" />
                                <CheckBox x:Name="Hotkeys">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="Ctrl+Alt+H" /><Run Text=" hides / shows fences, " />
                                        <Run FontWeight="SemiBold" Text="Ctrl+Alt+F" /><Run Text=" brings them in front of all windows until you switch to another window" />
                                    </TextBlock>
                                </CheckBox>
                                <TextBlock x:Name="HotkeyProblem" Style="{StaticResource Hint}" Margin="22,2,0,0" Foreground="#B05A00" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Windows" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <CheckBox x:Name="Startup" Content="Start with Windows" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Personalization -->
            <TabItem Header="Personalization">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <TextBlock Text="Personalization" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Colours and style of your fences." Style="{StaticResource PageIntro}" />

                        <TextBlock Text="Background colour" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="ColorTarget" Grid.ColumnSpan="2" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          SelectionChanged="ColorTarget_SelectionChanged" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Border x:Name="ColorPreview" Width="40" Height="24" CornerRadius="4" BorderBrush="#999" BorderThickness="1" Margin="0,0,8,0" />
                                    <Button Content="Pick from screen" Padding="8,2" Click="PickColor_Click"
                                            ToolTip="Click anywhere on the screen to use that colour" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Hue" Style="{StaticResource SliderLabel}" />
                                <Slider x:Name="HueSlider" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="360" VerticalAlignment="Center" ValueChanged="Color_Changed" />
                                <TextBlock Grid.Row="2" Text="Brightness" Style="{StaticResource SliderLabel}" />
                                <Slider x:Name="BrightSlider" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Color_Changed" />
                                <TextBlock Grid.Row="3" Text="Saturation" Style="{StaticResource SliderLabel}" />
                                <Slider x:Name="SatSlider" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Color_Changed" />
                                <TextBlock Grid.Row="4" Text="Transparency" Style="{StaticResource SliderLabel}" />
                                <Slider x:Name="TransSlider" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Color_Changed" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Icon tint" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="TintIcons" Content="Tint icons" Checked="Tint_Changed" Unchecked="Tint_Changed" />
                                <ComboBox x:Name="TintSource" Width="220" HorizontalAlignment="Left" Margin="0,4,0,6" SelectionChanged="Tint_Changed">
                                    <ComboBoxItem Content="Use the fence's colour" Tag="FenceColor" />
                                    <ComboBoxItem Content="Use a custom colour" Tag="Custom" />
                                </ComboBox>
                                <Grid x:Name="TintCustom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Hue" Style="{StaticResource SliderLabel}" />
                                    <Slider x:Name="TintHue" Grid.Column="1" Minimum="0" Maximum="360" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="Brightness" Style="{StaticResource SliderLabel}" />
                                    <Slider x:Name="TintBright" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="Saturation" Style="{StaticResource SliderLabel}" />
                                    <Slider x:Name="TintSat" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Blend with wallpaper" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="Blend" Content="Blend fences into the wallpaper until you point at them" />
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,0"
                                           Text="The background becomes see-through and icons turn grey and faint, so your desktop looks calm. Point at a fence to bring it back." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Title bars" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TitleAlways" GroupName="TitleBars" Content="Always visible" />
                                    <RadioButton x:Name="TitleHover" GroupName="TitleBars" Content="On mouse-over" />
                                    <RadioButton x:Name="TitleNever" GroupName="TitleBars" Content="Never" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8"
                                           Text="Without a title bar, drag a fence by its empty space. Fences with tabs always show their tabs." />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Title text" Style="{StaticResource SliderLabel}" />
                                    <ComboBox x:Name="TitleAlign" Width="140">
                                        <ComboBoxItem Content="Left" Tag="Left" />
                                        <ComboBoxItem Content="Centre" Tag="Center" />
                                        <ComboBoxItem Content="Right" Tag="Right" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Look and motion" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Icon size" Style="{StaticResource SliderLabel}" />
                                <ComboBox x:Name="IconSize" Grid.Column="1" Width="190" HorizontalAlignment="Left" Margin="0,3">
                                    <ComboBoxItem Content="Small (32)" Tag="32" />
                                    <ComboBoxItem Content="Medium (48)" Tag="48" />
                                    <ComboBoxItem Content="Large (64)" Tag="64" />
                                    <ComboBoxItem Content="Extra large (80)" Tag="80" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="When idle" Style="{StaticResource SliderLabel}" />
                                <ComboBox x:Name="IdleFade" Grid.Row="1" Grid.Column="1" Width="190" HorizontalAlignment="Left" Margin="0,3"
                                          ToolTip="Fences fade while the mouse isn't over them, and come back when you point at them.">
                                    <ComboBoxItem Content="Don't fade" Tag="1" />
                                    <ComboBoxItem Content="Fade a little" Tag="0.7" />
                                    <ComboBoxItem Content="Fade a lot" Tag="0.4" />
                                    <ComboBoxItem Content="Almost invisible" Tag="0.15" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="Roll up / down" Style="{StaticResource SliderLabel}" />
                                <ComboBox x:Name="RollSpeed" Grid.Row="2" Grid.Column="1" Width="190" HorizontalAlignment="Left" Margin="0,3">
                                    <ComboBoxItem Content="Instant" Tag="0" />
                                    <ComboBoxItem Content="Quick" Tag="150" />
                                    <ComboBoxItem Content="Smooth" Tag="300" />
                                    <ComboBoxItem Content="Slow" Tag="550" />
                                </ComboBox>
                                <CheckBox x:Name="Labels" Grid.Row="3" Grid.ColumnSpan="2" Content="Show icon names" Margin="0,8,0,4" />
                                <CheckBox x:Name="Rounded" Grid.Row="4" Grid.ColumnSpan="2" Content="Rounded corners" />
                                <CheckBox x:Name="AnimateMoves" Grid.Row="5" Grid.ColumnSpan="2" Content="Animate icons moving to new places (sorting, rearranging)" />
                                <CheckBox x:Name="HideScrollbars" Grid.Row="6" Grid.ColumnSpan="2" Content="Hide scrollbars until the mouse is over a fence" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Text colour and title bar position (top / bottom) are set per fence: right-click a fence → Customize…" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Tabs -->
            <TabItem Header="Tabs">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <TextBlock Text="Tabs" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Stack several fences in one place and switch between them with tabs." Style="{StaticResource PageIntro}" />

                        <TextBlock Text="Using tabs" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,2" Text="•  Drag a fence by its title and drop it on another fence's title bar to make tabs." />
                                <TextBlock TextWrapping="Wrap" Margin="0,2" Text="•  Click a tab to switch. Right-click → Tab to move a tab left / right or detach it." />
                                <TextBlock TextWrapping="Wrap" Margin="0,2" Text="•  Shift+click a tab to tear it off into its own fence." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="EnableTabs" Content="Allow creating new tabs" />
                                <CheckBox x:Name="ConfirmTabs" Content="Ask before creating new tabs" Margin="22,4,0,4" />
                                <CheckBox x:Name="HoverTabs" Content="Switch tabs when the mouse rests on them" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tab style" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <WrapPanel>
                                <RadioButton x:Name="TabSegmented" GroupName="TabStyle" Content="Segmented" />
                                <RadioButton x:Name="TabFlat" GroupName="TabStyle" Content="Flat (underlined)" />
                                <RadioButton x:Name="TabRounded" GroupName="TabStyle" Content="Rounded" />
                                <RadioButton x:Name="TabMenu" GroupName="TabStyle" Content="Menu only (▾ button)" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Rules -->
            <TabItem Header="Rules">
                <DockPanel Margin="22,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Rules" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageIntro}"
                                   Text="New icons that appear on the desktop are sorted into fences automatically by type, name, shortcut target, when they were created or how big they are. The first matching rule wins." />
                        <TextBlock Text="By default…" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="New icons that match no rule go to" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="DefaultFence" Width="220" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Rules (checked in order)" Style="{StaticResource SectionHeader}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add rule…" Padding="10,3" Margin="0,0,6,0" Click="AddRule_Click" />
                            <Button Content="Edit…" Padding="10,3" Margin="0,0,6,0" Click="EditRule_Click" />
                            <Button Content="Remove" Padding="10,3" Margin="0,0,16,0" Click="RemoveRule_Click" />
                            <Button Content="▲" Padding="10,3" Margin="0,0,4,0" ToolTip="Move up" Click="RuleUp_Click" />
                            <Button Content="▼" Padding="10,3" ToolTip="Move down" Click="RuleDown_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Each fence can also have its own simple list of extensions and name patterns: right-click it → Customize…" />
                    </StackPanel>
                    <ListBox x:Name="RulesList" MinHeight="140" MouseDoubleClick="EditRule_Click" HorizontalContentAlignment="Stretch" />
                </DockPanel>
            </TabItem>

            <!-- ============================================================ Layout -->
            <TabItem Header="Layout">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <TextBlock Text="Layout" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Backups, snapping, icon spacing and monitors." Style="{StaticResource PageIntro}" />

                        <TextBlock Text="Backups" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="DailyBackups" Content="Take a backup every day (the last 7 days are kept)" />
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                           Text="Restore a day's fence layout from the tray menu → Layouts → Daily backups. Full copies of your settings are kept in the Backups folder." />
                                <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                                    <Button Content="Back up now" Padding="10,3" Margin="0,0,6,0" Click="BackupNow_Click" />
                                    <Button Content="Open backups folder" Padding="10,3" Click="OpenBackups_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Snapping" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox x:Name="Snap" Content="Snap fences to screen edges and each other" />
                                <StackPanel Orientation="Horizontal" Margin="22,2,0,2">
                                    <CheckBox x:Name="SnapSpacing" Content="Keep fences" VerticalAlignment="Center" />
                                    <TextBox x:Name="SnapSpacingPx" Width="44" Margin="6,0" Padding="3,1" VerticalAlignment="Center" />
                                    <TextBlock Text="pixels apart (otherwise their edges touch)" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox x:Name="SnapGrid" Margin="22,4,0,4" Content="Size fences to whole rows and columns of icons when resizing" />
                                <CheckBox x:Name="SnapAlign" Margin="22,4,0,4" Content="Line up fence edges with nearby fences when moving" />
                                <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0" Text="Hold Alt while moving or resizing to skip snapping." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Icon spacing" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <CheckBox x:Name="MatchSpacing" Content="Space icons in fences the same as icons on the desktop" />
                        </Border>

                        <TextBlock Text="Monitors" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Swap monitors" Padding="10,3" Click="SwapMonitors_Click" />
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="Moves every fence to the other monitor, keeping its place." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
